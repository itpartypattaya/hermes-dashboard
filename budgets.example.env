# Budget references — a plain shell file (KEY=value lines and comments only).
# The build loads it into the environment, so the same numbers reach both the
# dashboard and any alert cron of yours that sources this file. Nothing here
# throttles the agent: these are reference points, not limits.
CODEX_WEEKLY_INPUT_BUDGET=25000000   # weekly input reference (tokens); the Cost bar uses it only while providers.primary.weekly_input_budget is 0
CODEX_SUB_USD_MO=20                  # subscription price ($/month); used only while providers.primary.subscription_usd_month is 0
HERMES_DASHBOARD_QUOTA_ALERT_PCT=15  # the quota collector's --alert mode speaks up when less than this % of the window remains
